  "usage_rules": [
    "Use only to represent one active filter — label identifies the field, value shows the applied filter.",
    "Always compose inside a Filter Bar. Do not place standalone.",
    "In Open state, chevron rotates 180deg to indicate the filter dropdown panel is visible.",
    "In No Value state, show label only with a chevron. This is an unset filter trigger.",
    "The chip is NOT a Button variant. Do not style it as a Button. It is an independent interactive pill.",
    "Disabled state: interaction blocked, muted colors applied."
  ],
  "anti_patterns": [
    "Do not use Filter Chip as a general toggle or selection control.",
    "Do not implement as Button component — it has its own pill radius and padding.",
    "Do not put more than one label+value pair inside a single chip.",
    "Do not use for navigation — only for filter state representation."
  ],
