{
  "name": "px-prism-shadcn-poc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:docs-standalone": "vite build --config vite.docs.config.ts",
    "tokens:generate": "node scripts/generate-prism-css.mjs",
    "tokens:validate": "node scripts/validate-prism-tokens.mjs",
    "tokens:guard": "node scripts/validate-protected-tokens.mjs",
    "tokens:alias-debt": "node scripts/validate-alias-debt.mjs",
    "tokens:sync-report": "node scripts/generate-sync-report.mjs",
    "tokens:no-self-approval": "node scripts/validate-no-self-approval.mjs",
    "test:token-guardrails": "node --test \"tests/token-guardrails/*.test.mjs\"",
    "figma-coverage:validate": "node scripts/validate-figma-coverage.mjs",
    "test:figma-coverage": "node --test \"tests/figma-coverage/*.test.mjs\"",
    "test:color": "node --experimental-strip-types --test \"tests/color/*.test.mjs\"",
    "figma:sync": "node scripts/figma-sync.mjs",
    "figma:bridge": "node scripts/figma-local-bridge.mjs",
    "icons:import": "node scripts/import-prism-icons.mjs",
    "icons:normalise": "node scripts/normalise-prism-icons.mjs"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.1",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.27.0",
    "prop-types": "^15.8.1",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-is": "^19.2.8",
    "react-simple-maps": "^3.0.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-simple-maps": "^3.0.6",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "overrides": {
    "react-simple-maps": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  }
}
